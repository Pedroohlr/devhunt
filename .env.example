# Copie para .env e preencha — ou deixe o `vagas setup` escrever isto para você.
# Este arquivo é só exemplo; o .env de verdade não vai para o git.

# Chave da Anthropic (console.anthropic.com → API Keys). Sem ela a ferramenta ainda roda
# pelo caminho determinístico (classificação por regras, currículo reaproveitado, banco de
# respostas), mas não escreve currículo novo nem responde pergunta aberta.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelos (padrão em config/settings.yaml)
# VAGAS_LLM_CHEAP_MODEL=gpt-4.1-mini
# VAGAS_LLM_SMART_MODEL=gpt-4.1

# Senha do LinkedIn (opcional): usada para entrar na Gupy via "Entrar com LinkedIn"
LINKEDIN_PASSWORD=
# Login da Gupy (opcional): o e-mail vem do perfil; a senha fica aqui
GUPY_PASSWORD=
# Conta de e-mail separada para cadastros em ATS que exigem criar conta (opcional).
# A ferramenta lê o e-mail de confirmação nessa caixa (Gmail aberto no navegador dela).
SIGNUP_EMAIL=
ATS_SIGNUP_PASSWORD=

# Avisos no Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
